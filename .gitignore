*.iml
.gradle
/local.properties
# All of it, not the handful of files the Android Studio template lists. The rest of the
# directory is regenerated on every SDK, JDK or plugin change, so it shows up as a diff
# nobody made and nobody reviews.
.idea/
.DS_Store
/build
/captures
.externalNativeBuild
.cxx
local.properties
.kotlin

# Claude Code's working directory. It holds git worktrees under
# .claude/worktrees/, so committing it would put a second full copy of this
# repository inside the repository.
.claude/

# Firebase CLI logs, written wherever the command happens to run.
firebase-debug.log
firestore-debug.log

# Firebase service-account keys. These bypass every security rule, so they never belong in
# a repository - least of all one with a GitHub remote. Seeding scripts read them from a
# path outside the project.
*firebase-adminsdk*.json
service-account*.json
