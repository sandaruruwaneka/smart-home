rules_version = '2';

// Security rules for the Smart Home Monitoring & Control System.
//
// SCHEMA.md section 13 gives the *shape* of these rules in shorthand; this is that shape
// written in real rules syntax, since Firestore has no `where collection in [...]` form.
// Rules are Dev B's territory -- any change here needs to be agreed, the same as a change
// to the data contract itself.
//
// Deploy with: firebase deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Ownership is carried by `owner_uid` on every top-level document, which is what makes
    // flat collections workable: the rule is the same everywhere and needs no lookups.
    function owns(data) {
      return signedIn() && request.auth.uid == data.owner_uid;
    }

    // The profile document's id is the uid itself -- the one collection not using auto-ids.
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /floors/{floorId} {
      allow read, update, delete: if owns(resource.data);
      allow create: if owns(request.resource.data);
    }

    match /devices/{deviceId} {
      allow read, update, delete: if owns(resource.data);
      allow create: if owns(request.resource.data);

      // Channels carry no `owner_uid` of their own, so ownership is read from the parent.
      // This is a document read per rule evaluation and therefore billable -- acceptable
      // here because channels are only touched from an open device sheet.
      match /channels/{channelId} {
        function parentExists() {
          return exists(/databases/$(database)/documents/devices/$(deviceId));
        }
        function parentOwner() {
          return get(/databases/$(database)/documents/devices/$(deviceId)).data.owner_uid;
        }

        allow read, update, delete: if signedIn()
          && parentExists()
          && request.auth.uid == parentOwner();

        // Create is the one operation where the parent may legitimately not exist yet.
        // A switch bank and its channels are written in a single batch -- deliberately, so
        // a unit is never briefly visible with no channels and therefore no derivable
        // status -- but rules are evaluated against *committed* state, one write at a time.
        // The channel writes in that batch are judged against a world where the device
        // document has not landed, so `get()` finds nothing and the whole batch is
        // rejected. Placing a switch bank was impossible until this branch existed.
        //
        // What it costs: a signed-in user can create channel documents under a device id
        // that does not exist. They are unreachable -- nothing queries channels except
        // through a parent -- so the exposure is orphaned writes by an authenticated
        // account, not access to anybody's data.
        //
        // The cleaner fix is `owner_uid` on the channel document itself: one rule, no
        // lookup, no per-evaluation read cost, and no escape hatch. It is not done here
        // because it is a SCHEMA change that would reject the simulator's channel writes
        // until Dev B updates to match, and this file says changes need agreeing.
        allow create: if signedIn() && (!parentExists() || request.auth.uid == parentOwner());
      }
    }

    match /usage_events/{eventId} {
      allow read, update, delete: if owns(resource.data);
      allow create: if owns(request.resource.data);
    }

    match /alerts/{alertId} {
      allow read: if owns(resource.data);

      // The app acknowledges alerts and does nothing else to them. Restricting the update
      // to that single field means a client cannot rewrite an alert's message or device
      // name to something the worker never said.
      allow update: if owns(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['acknowledged']);

      // Alerts are raised by the safety worker only. The Admin SDK bypasses rules, so
      // denying clients outright costs the worker nothing -- and an alert the app could
      // invent would be one no worker could ever clear.
      allow create, delete: if false;
    }
  }
}
